# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # solo servidor: webhook de pagos y borrar cuentas

# URL pública de la web (para enlaces de los emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe. Core: 14,99 € + IVA/mes · Pro: 24,99 € + IVA/mes (precios con impuesto "exclusivo")
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CORE=
STRIPE_PRICE_PRO=
# Anual: 2 meses gratis (149,90 € y 249,90 € + IVA/año)
STRIPE_PRICE_CORE_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=
# IVA automático con Stripe Tax (actívalo en el panel de Stripe). Pon false para desactivarlo.
# STRIPE_AUTOMATIC_TAX=true

# IA (paso 4). Solo servidor
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=   # opcional
